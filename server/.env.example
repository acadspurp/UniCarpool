PORT=3001

# Firebase Admin — paste full JSON from Firebase Console → Service accounts → Generate key
FIREBASE_SERVICE_ACCOUNT_JSON=

# Resend (https://resend.com) — free tier works
RESEND_API_KEY=
RESEND_FROM=UniCarpool <onboarding@resend.dev>

# Brevo HTTP API (recommended when SMTP times out on hosting providers)
BREVO_API_KEY=

# Optional SMTP instead of Resend
# OTP_SMTP_HOST=smtp.gmail.com
# OTP_SMTP_PORT=465
# OTP_SMTP_USER=
# OTP_SMTP_PASS=

# Comma-separated origins allowed to call this API (your Hosting URL + local dev)
CORS_ORIGINS=http://localhost:8081,https://unicarpool-f49e4.web.app,https://unicarpool-f49e4.firebaseapp.com
